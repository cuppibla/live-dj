# Gemini Developer API (AI Studio) — NOT Vertex
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-key-here

# the live model + Mira's native voice (NOT her aniradio TTS voice — Live has its own set)
LIVE_MODEL=gemini-3.1-flash-live-preview
LIVE_VOICE=Aoede

# optional — silences ADK OpenTelemetry chatter when running the ADK version (EP2)
OTEL_SDK_DISABLED=true
