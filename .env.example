# Gemini Developer API (AI Studio) — NOT Vertex
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-key-here

# the live model + the consultant's native voice (the Live API has its own voice set)
LIVE_MODEL=gemini-3.1-flash-live-preview
LIVE_VOICE=Aoede

# which customer configuration to load from company-configs/
COMPANY_PROFILE=kittichet
